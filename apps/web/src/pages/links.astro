---
import Layout from '@/layouts/Layout.astro';
import { api } from '@/lib/api';
import { getCollection } from 'astro:content';

const config = await api.config().catch(() => null);
const override = await api.page('links').catch(() => null);
const title = override?.title || '友链';

interface LinkItem {
  id: string;
  name: string;
  url: string;
  description: string | null;
  avatar: string | null;
}

let links: LinkItem[] = [];
let error = false;
try {
  links = await api.links();
} catch {
  error = true;
  links = (await getCollection('posts'))
    .slice(0, 0)
    .map(() => ({ id: '', name: '', url: '', description: null, avatar: null }));
}

function initial(name: string): string {
  return (name || '?').trim().charAt(0);
}
---

<Layout title={title} description={config?.seo.description} config={config}>
  {override ? (
    <article class="mx-auto max-w-4xl px-6 py-10">
      <header class="mb-10">
        <h1 class="text-2xl md:text-3xl font-extrabold leading-tight mb-4 font-serif">{override.title}</h1>
      </header>
      {override.html ? (
        <div class="prose max-w-none" set:html={override.html} />
      ) : (
        <p class="text-muted-foreground">页面内容为空。</p>
      )}
    </article>
  ) : (
  <section class="mx-auto max-w-4xl px-6 pt-12 pb-12">
    <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-3 font-serif">友链</h1>
    <p class="text-base text-muted-foreground mb-10">共收录 {links.length} 位好友。</p>

    {error && <p class="text-muted-foreground mb-4 text-xs">（暂无后端友链数据）</p>}

    {links.length === 0 ? (
      <p class="text-muted-foreground">暂无友链。</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener"
            class="group flex items-start gap-4 border border-border rounded-lg p-5 hover:border-foreground transition-colors"
          >
            {link.avatar ? (
              <img src={link.avatar} alt={link.name} class="h-12 w-12 rounded-full object-cover border border-border" />
            ) : (
              <span class="h-12 w-12 rounded-full bg-muted flex items-center justify-center font-serif text-lg text-muted-foreground">
                {initial(link.name)}
              </span>
            )}
            <div class="min-w-0">
              <div class="font-serif font-bold text-[15px] group-hover:underline underline-offset-4">
                {link.name}
              </div>
              <div class="text-xs text-muted-foreground truncate mt-0.5">{link.url}</div>
              {link.description && (
                <p class="text-sm text-muted-foreground mt-1.5 leading-relaxed">{link.description}</p>
              )}
            </div>
          </a>
        ))}
      </div>
    )}

    <section class="mt-16 border-t border-border pt-10">
      <h2 class="text-lg font-bold font-serif mb-3">申请友链</h2>
      <p class="text-sm text-muted-foreground leading-relaxed mb-6">
        欢迎交换友链，请在下方评论区留言提交：<strong class="text-foreground">站点名称</strong> +
        <strong class="text-foreground">链接</strong> + <strong class="text-foreground">一句简介</strong>，
        我会尽快审核并收录。
      </p>
      {config?.features.comments.walineServerURL || import.meta.env.PUBLIC_WALINE_SERVER_URL ? (
        <div id="waline" data-waline-url={config?.features.comments.walineServerURL || import.meta.env.PUBLIC_WALINE_SERVER_URL}></div>
      ) : (
        <p class="text-sm text-muted-foreground">评论系统尚未配置 Waline 服务地址（请在后台「评论系统」中设置）。</p>
      )}
    </section>
  </section>
  )}
</Layout>

<script>
  import { init } from '@waline/client';
  import '@waline/client/style';

  function initComments() {
    const el = document.getElementById('waline');
    if (el) {
      init({
        el: '#waline',
        serverURL: el.dataset.walineUrl,
        path: '/links',
        lang: 'zh-CN',
        dark: 'html[data-theme="dark"]',
        pageview: true,
        comment: true,
      });
    }
  }
  initComments();
  document.addEventListener('astro:page-load', initComments);
</script>
