---
import Layout from '@/layouts/Layout.astro';
import { api } from '@/lib/api';

const { slug } = Astro.params;
const config = await api.config().catch(() => null);

if (!slug) return Astro.redirect('/404');

const page = await api.page(slug).catch(() => null);
if (!page) return Astro.redirect('/404');

const comments = config?.features.comments ?? null;
const configuredWaline = comments?.provider === 'waline' && comments.walineServerURL ? comments.walineServerURL : '';
---

<Layout title={page.title} description={config?.seo.description} config={config}>
  <article class="mx-auto max-w-4xl px-6 py-10">
    <header class="mb-10">
      <h1 class="text-2xl md:text-3xl font-extrabold leading-tight mb-4 font-serif">
        {page.title}
      </h1>
    </header>

    {page.html ? (
      <div class="prose max-w-none" set:html={page.html} />
    ) : (
      <p class="text-muted-foreground">页面内容为空。</p>
    )}

    {comments && comments.enabled && page.commentsEnabled !== false && (
      <section class="comments" id="comments">
        <h2 class="comments-title">评论</h2>
        {comments.provider === 'giscus' && comments.giscusRepo && (
          <script
            is:inline
            src="https://giscus.app/client.js"
            data-repo={comments.giscusRepo}
            data-repo-id={comments.giscusRepoId}
            data-category={comments.giscusCategory}
            data-category-id={comments.giscusCategoryId}
            data-mapping="pathname"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="bottom"
            data-theme="preferred_color_scheme"
            data-lang="zh-CN"
            data-loading="lazy"
            crossorigin="anonymous"
            async
          />
        )}
        {comments.provider === 'utterances' && (comments.utterancesRepo || comments.giscusRepo) && (
          <script
            is:inline
            src="https://utteranc.es/client.js"
            data-repo={comments.utterancesRepo || comments.giscusRepo}
            data-issue-term="pathname"
            data-theme="preferred_color_scheme"
            data-label="comments"
            crossorigin="anonymous"
            async
          />
        )}
        {comments.provider === 'waline' && configuredWaline && (
          <div id="waline" data-waline-path={`/pages/${slug}`}></div>
        )}
        {!['giscus', 'utterances', 'waline'].includes(comments.provider) && (
          <p class="comments-note">评论系统尚未配置（请在后台「评论系统」中配置）。</p>
        )}
        {comments.provider === 'waline' && !configuredWaline && (
          <p class="comments-note">评论系统尚未配置 Waline 服务地址（请在后台「评论系统」中设置）。</p>
        )}
      </section>
    )}

    <div class="mt-16 pt-8">
      <a href="/" class="inline-flex items-center gap-2 text-sm font-serif text-muted-foreground hover:text-accent transition-colors">
        <span>&larr;</span> 返回首页
      </a>
    </div>
  </article>
</Layout>

<script define:vars={{ walineServerURL: configuredWaline }}>
  import { init } from '@waline/client';
  import '@waline/client/style';

  function initComments() {
    const el = document.getElementById('waline');
    if (el && walineServerURL) {
      init({
        el: '#waline',
        serverURL: walineServerURL,
        path: el.dataset.walinePath || window.location.pathname,
        lang: 'zh-CN',
        dark: 'html[data-theme="dark"]',
        pageview: true,
        comment: true,
      });
    }
  }
  initComments();
  document.addEventListener('astro:page-load', initComments);
</script>