---
import Layout from '@/layouts/Layout.astro';
import { api } from '@/lib/api';
import { getCollection } from 'astro:content';

interface ArchiveItem {
  slug: string;
  title: string;
  date: Date;
}

let items: ArchiveItem[] = [];
let error = false;

try {
  const first = await api.posts(1, 50);
  items = first.items
    .filter((p) => p.publishedAt)
    .map((p) => ({ slug: p.slug, title: p.title, date: new Date(p.publishedAt!) }));
} catch {
  error = true;
  const local = await getCollection('posts');
  items = local.map((p) => ({
    slug: p.id.replace(/\.md$/, ''),
    title: p.data.title,
    date: p.data.pubDate,
  }));
}

items.sort((a, b) => b.date.getTime() - a.date.getTime());

const grouped = new Map<string, Map<string, ArchiveItem[]>>();
for (const it of items) {
  const year = `${it.date.getFullYear()}`;
  const month = `${it.date.getFullYear()}年${it.date.getMonth() + 1}月`;
  if (!grouped.has(year)) grouped.set(year, new Map());
  const byMonth = grouped.get(year)!;
  if (!byMonth.has(month)) byMonth.set(month, []);
  byMonth.get(month)!.push(it);
}

const years = [...grouped.keys()].sort((a, b) => Number(b) - Number(a));

function day(date: Date): string {
  const mo = date.getMonth() + 1;
  const d = date.getDate();
  return `${mo}月${d}日`;
}
---

<Layout title="归档" description="按时间归档所有文章。">
  <section class="mx-auto max-w-4xl px-6 pt-12 pb-12">
    <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-3 font-serif">归档</h1>
    <p class="text-base text-muted-foreground mb-10">共 {items.length} 篇文章，按时间排列。</p>

    {error && <p class="text-muted-foreground mb-4 text-xs">（本地示例文章，服务器未连接）</p>}

    {items.length === 0 ? (
      <p class="text-muted-foreground">暂无文章。</p>
    ) : (
      <div class="relative pl-8 border-l border-border ml-1.5">
        {years.map((year) => {
          const byMonth = grouped.get(year)!;
          return (
            <div class="relative mb-12">
              {/* Year dot on the timeline */}
              <span class="absolute -left-[37px] top-1.5 h-3 w-3 rounded-full bg-foreground" />
              <h2 class="text-xl font-bold tracking-tight font-serif mb-1">
                {year}
                <span class="ml-3 text-sm font-normal font-sans text-muted-foreground">
                  {[...byMonth.values()].reduce((n, arr) => n + arr.length, 0)} 篇
                </span>
              </h2>
              <div class="mt-4">
                {[...byMonth.entries()].map(([month, arr]) => (
                  <div class="mb-2">
                    <h3 class="text-sm text-muted-foreground mb-2 tracking-wide">
                      {month}
                    </h3>
                    <div>
                      {arr.map((item) => (
                        <a
                          href={`/posts/${item.slug}`}
                          class="group relative flex flex-col md:flex-row md:items-baseline gap-0.5 md:gap-4 py-2"
                        >
                          {/* Dot on the timeline for each post */}
                          <span class="absolute -left-[31px] top-[0.85rem] h-1.5 w-1.5 rounded-full bg-border group-hover:bg-foreground transition-colors" />
                          <span class="font-mono text-xs text-muted-foreground md:w-12 md:shrink-0 md:text-right md:text-sm tabular-nums tracking-wide">
                            {day(item.date)}
                          </span>
                          <span class="text-[15px] md:min-w-0 truncate group-hover:underline underline-offset-4 transition-colors">
                            {item.title}
                          </span>
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    )}
  </section>
</Layout>
