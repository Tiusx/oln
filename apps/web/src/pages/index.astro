---
import Layout from '../layouts/Layout.astro';
import { api } from '../lib/api';
import { renderMarkdown, formatDateShort } from '../lib/markdown';

export const prerender = false;

const config = await api.config();
const homeLatestCount = config.basic.homeLatestCount ?? 5;
const data = await api.posts(1, homeLatestCount);
const posts = data.items;

const bioRaw = config.basic.bio || '';
const bioHtml = bioRaw ? renderMarkdown(bioRaw) : '';
---

<Layout description={config.seo.description} config={config}>
  {bioHtml && (
    <header class="home-head">
      <div class="home-bio" set:html={bioHtml} />
    </header>
  )}

  <section class="home-section">
    <div class="home-section-head">
      <h2 class="home-section-title">最新文章</h2>
      <a class="home-section-more" href="/posts">查看全部 →</a>
    </div>
    {posts.length === 0 ? (
      <div class="empty"><p>暂无文章，敬请期待。</p></div>
    ) : (
      <ul class="home-latest">
        {posts.map((post) => (
          <li class="home-latest-item">
            <a class="home-latest-link" href={`/posts/${post.slug}`}>
              {post.pinned && <span class="min-pin">置顶</span>}
              <span class="home-latest-title">{post.title}</span>
              <time class="home-latest-date" datetime={post.publishedAt ?? undefined}>
                {formatDateShort(post.publishedAt, config.basic.language)}
              </time>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>