---
import Layout from '@/layouts/Layout.astro';
import { api } from '@/lib/api';
import { getCollection } from 'astro:content';

const config = await api.config().catch(() => null);
const homeLatestCount = config?.basic.homeLatestCount || 5;

let postsData: Awaited<ReturnType<typeof api.posts>> | null = null;
let error = false;
try {
  postsData = await api.posts(1, Math.min(homeLatestCount, 50));
} catch {
  error = true;
}

const localPosts = await getCollection('posts');
const fallbackLocal = localPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

function formatDateShort(dateStr: string | null | Date): string {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return `${d.getFullYear()}.${`0${d.getMonth() + 1}`.slice(-2)}.${`0${d.getDate()}`.slice(-2)}`;
}

interface Item {
  slug: string;
  title: string;
  date: string | null | Date;
  category?: { name: string; slug: string } | null;
  pinned?: boolean;
}

let items: Item[] = [];
if (error && postsData === null) {
  items = fallbackLocal.slice(0, homeLatestCount).map((p) => ({
    slug: p.id.replace(/\.md$/, ''),
    title: p.data.title,
    date: p.data.pubDate,
  }));
} else if (postsData) {
  items = postsData.items.map((p) => ({
    slug: p.slug,
    title: p.title,
    date: p.publishedAt,
    category: p.category,
    pinned: p.pinned,
  }));
}

const siteName = config?.basic.siteName || 'Blog';
const tagline = config?.basic.tagline || '记录想法与成长';
const totalPosts = postsData?.total ?? fallbackLocal.length;
---

<Layout title="" description={config?.seo.description} config={config}>
  <section class="mx-auto max-w-4xl px-6 pt-12 pb-10">
    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight font-serif mb-3">{siteName}</h1>
    <p class="text-base text-muted-foreground max-w-xl leading-relaxed">{tagline}</p>
    {error && postsData === null && (
      <p class="text-muted-foreground mt-4 text-xs">（本地示例文章，服务器未连接）</p>
    )}
  </section>

  <section class="mx-auto max-w-4xl px-6 pb-14">
    <div class="flex items-baseline justify-between mb-2">
      <h2 class="text-lg font-bold tracking-tight font-serif">最新文章</h2>
      <a href="/posts" class="text-sm text-muted-foreground hover:text-foreground transition-colors">
        全部 {totalPosts} 篇 &rarr;
      </a>
    </div>

    {items.length > 0 ? (
      <div>
        {items.map((post) => (
          <a
            href={`/posts/${post.slug}`}
            class="group flex flex-col md:flex-row md:items-baseline gap-1 md:gap-6 py-5"
          >
            <time class="text-xs text-muted-foreground font-mono tabular-nums md:w-24 md:shrink-0 md:text-sm">
              {formatDateShort(post.date)}
            </time>
            <span class="flex flex-wrap items-baseline gap-x-2 text-[15px] leading-snug md:min-w-0">
              {post.pinned && <span class="text-foreground mr-0.5">·</span>}
              <span class="group-hover:underline underline-offset-4 transition-colors">
                {post.title}
              </span>
              {post.category && (
                <span class="text-xs text-muted-foreground font-sans">· {post.category.name}</span>
              )}
            </span>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-muted-foreground py-8">暂无文章。</p>
    )}
  </section>
</Layout>
