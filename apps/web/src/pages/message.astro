---
import Layout from '@/layouts/Layout.astro';
import { api } from '@/lib/api';

let quote: { content: string; creator: string | null } | null = null;
try {
  quote = await api.hitokoto();
} catch {
  quote = null;
}
const override = await api.page('message').catch(() => null);
const title = override?.title || '留言板';
---

<Layout title={title} description="欢迎在这里留下你的想法。">
  {override ? (
    <article class="mx-auto max-w-4xl px-6 py-10">
      <header class="mb-10">
        <h1 class="text-2xl md:text-3xl font-extrabold leading-tight mb-4 font-serif">{override.title}</h1>
      </header>
      {override.html ? (
        <div class="prose max-w-none" set:html={override.html} />
      ) : (
        <p class="text-muted-foreground">页面内容为空。</p>
      )}
    </article>
  ) : (
  <section class="mx-auto max-w-4xl px-6 pt-12 pb-12">
    <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-3 font-serif">留言板</h1>
    <p class="text-base text-muted-foreground mb-10">欢迎在这里留下你的足迹、想法和建议。</p>

    {quote && (
      <figure class="mb-12 border-l-[3px] border-accent pl-6">
        <blockquote class="text-lg md:text-xl leading-relaxed text-foreground font-serif">
          “{quote.content}”
        </blockquote>
        {quote.creator && (
          <figcaption class="mt-3 text-sm text-muted-foreground">
            —— {quote.creator}
          </figcaption>
        )}
      </figure>
    )}

    <div class="mb-8">
      <h2 class="text-base font-bold tracking-tight mb-4 font-serif">留言区</h2>
      <p class="text-muted-foreground text-sm pt-4 leading-relaxed">
        留言功能正在接入中。你可以通过文章评论或直接写信与我交流，感谢你的支持与鼓励。
      </p>
    </div>
  </section>
  )}
</Layout>
