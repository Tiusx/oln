---
import Layout from '../../layouts/Layout.astro';
import { api } from '../../lib/api';
import { formatDate } from '../../lib/markdown';

export const prerender = false;

const { slug } = Astro.params;
const config = await api.config();
const categories = await api.categories();
const categoryName = categories.find((c) => c.slug === slug)?.name || slug;
const data = await api.posts(1, 50, slug);
const posts = data.items;
---

<Layout title={categoryName} config={config}>
  <header class="page-head">
    <h1>{categoryName}</h1>
    <p class="page-sub">共 {posts.length} 篇文章</p>
  </header>
  {posts.length === 0 ? (
    <div class="empty">该分类暂无文章。</div>
  ) : (
    <div class="post-list">
      {posts.map((post) => (
        <article class="post">
          <h2 class="post-title"><a href={`/posts/${post.slug}`}>{post.title}</a></h2>
          <div class="post-meta">
            <time datetime={post.publishedAt ?? undefined}>{formatDate(post.publishedAt, config.basic.language)}</time>
            {post.category && <><span class="dot">·</span><a href={`/categories/${post.category.slug}`}>{post.category.name}</a></>}
          </div>
          {post.excerpt && <p class="post-excerpt">{post.excerpt}</p>}
        </article>
      ))}
    </div>
  )}
</Layout>
