---
import Layout from '@/layouts/Layout.astro';
import { api } from '@/lib/api';

const config = await api.config().catch(() => null);
const author = config?.author;
const siteName = config?.basic.siteName || 'Blog';
const siteBio = config?.basic.bio || '';
const override = await api.page('about').catch(() => null);
const title = override?.title || '关于';
const comments = config?.features.comments ?? null;
const configuredWaline = comments?.provider === 'waline' && comments.walineServerURL ? comments.walineServerURL : '';
---

<Layout title={title} description={config?.seo.description} config={config}>
  {override ? (
    <article class="mx-auto max-w-4xl px-6 py-10">
      <header class="mb-10">
        <h1 class="text-2xl md:text-3xl font-extrabold leading-tight mb-4 font-serif">{override.title}</h1>
      </header>
      {override.html ? (
        <div class="prose max-w-none" set:html={override.html} />
      ) : (
        <p class="text-muted-foreground">页面内容为空。</p>
      )}

      {comments && comments.enabled && override.commentsEnabled !== false && (
        <section class="comments" id="comments">
          <h2 class="comments-title">评论</h2>
          {comments.provider === 'giscus' && comments.giscusRepo && (
            <script
              is:inline
              src="https://giscus.app/client.js"
              data-repo={comments.giscusRepo}
              data-repo-id={comments.giscusRepoId}
              data-category={comments.giscusCategory}
              data-category-id={comments.giscusCategoryId}
              data-mapping="pathname"
              data-strict="0"
              data-reactions-enabled="1"
              data-emit-metadata="0"
              data-input-position="bottom"
              data-theme="preferred_color_scheme"
              data-lang="zh-CN"
              data-loading="lazy"
              crossorigin="anonymous"
              async
            />
          )}
          {comments.provider === 'utterances' && (comments.utterancesRepo || comments.giscusRepo) && (
            <script
              is:inline
              src="https://utteranc.es/client.js"
              data-repo={comments.utterancesRepo || comments.giscusRepo}
              data-issue-term="pathname"
              data-theme="preferred_color_scheme"
              data-label="comments"
              crossorigin="anonymous"
              async
            />
          )}
          {comments.provider === 'waline' && configuredWaline && (
            <div id="waline" data-waline-path="/pages/about" data-waline-url={configuredWaline}></div>
          )}
          {!['giscus', 'utterances', 'waline'].includes(comments.provider) && (
            <p class="comments-note">评论系统尚未配置（请在后台「评论系统」中配置）。</p>
          )}
          {comments.provider === 'waline' && !configuredWaline && (
            <p class="comments-note">评论系统尚未配置 Waline 服务地址（请在后台「评论系统」中设置）。</p>
          )}
        </section>
      )}
    </article>
  ) : (
  <section class="mx-auto max-w-4xl px-6 pt-12 pb-12">
    <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight mb-3 font-serif">关于</h1>
    <p class="text-base text-muted-foreground mb-10">了解这个博客与博主。</p>

    {author?.name && (
      <div class="flex items-center gap-5 mb-8">
        {author.avatar && (
          <img src={author.avatar} alt={author.name} class="h-20 w-20 rounded-full object-cover border border-border" />
        )}
        <div>
          <div class="font-serif text-xl font-bold">{author.name}</div>
          {author.bio && <div class="text-sm text-muted-foreground mt-1">{author.bio}</div>}
          {author.socials && author.socials.length > 0 && (
            <div class="flex gap-4 mt-2 text-sm">
              {author.socials.map((s) => (
                <a href={s.url} target="_blank" rel="noopener" class="text-foreground hover:underline underline-offset-4">
                  {s.label}
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    )}

    <div class="prose max-w-none">
      <p>这是「{siteName}」的关于页面，记录技术与生活思考。</p>
      {siteBio && <p>{siteBio}</p>}
      <h2>技术栈</h2>
      <ul>
        <li><strong>Astro</strong> — 服务端渲染 + Cloudflare Pages</li>
        <li><strong>Tailwind CSS v4</strong> — CSS-first 配置</li>
        <li><strong>shadcn/ui</strong> — 精心设计的 UI 组件</li>
      </ul>
      <h2>联系我</h2>
      <p>有任何问题或建议，欢迎通过文章评论与我联系。</p>
    </div>
  </section>
  )}
</Layout>

<script>
  import { init } from '@waline/client';
  import '@waline/client/style';

  function initComments() {
    const el = document.getElementById('waline');
    if (el) {
      init({
        el: '#waline',
        serverURL: el.dataset.walineUrl,
        path: el.dataset.walinePath || window.location.pathname,
        lang: 'zh-CN',
        dark: 'html[data-theme="dark"]',
        pageview: true,
        comment: true,
      });
    }
  }
  initComments();
  document.addEventListener('astro:page-load', initComments);
</script>
