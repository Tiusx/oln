---
import Layout from '@/layouts/Layout.astro';
import { api } from '@/lib/api';
import { getCollection, render } from 'astro:content';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/404');

let post: Awaited<ReturnType<typeof api.post>>;
try {
  post = await api.post(slug);
} catch {
  post = null;
}

const config = await api.config().catch(() => null);
const comments = config?.features.comments ?? null;
const configuredWaline = comments?.provider === 'waline' && comments.walineServerURL ? comments.walineServerURL : '';

let LocalContent: any = null;
let localData: { title: string; description?: string; pubDate: Date; tags: string[] } | null = null;

if (!post) {
  const posts = await getCollection('posts');
  const match = posts.find((p) => p.id.replace(/\.md$/, '') === slug);
  if (match) {
    const rendered = await render(match);
    LocalContent = rendered.Content;
    localData = match.data;
  }
  if (!localData) return Astro.redirect('/404');
}

const tags = post
  ? post.tags.map((t) => t.name)
  : localData!.tags;

function formatDate(dateStr: string | null | Date): string {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
}

function formatDateFull(dateStr: string | null | Date): string {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
}
---

<Layout
  title={post?.seoTitle || post?.title || localData?.title}
  description={post?.seoDescription || post?.excerpt || localData?.description || ''}
  config={config}
  type="article"
  image={post?.coverImage || undefined}
>
  <article class="mx-auto max-w-4xl px-6 py-10">
    <!-- 分类条 -->
    {post?.category && (
      <div class="mb-5">
        <span class="text-xs font-medium text-muted-foreground tracking-widest uppercase">
          {post.category.name}
        </span>
      </div>
    )}

    <header class="mb-10">
      <h1 class="text-2xl md:text-3xl font-extrabold leading-tight mb-4 font-serif">
        {post?.title || localData!.title}
      </h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-muted-foreground">
        <time class="font-mono">{post ? formatDate(post.publishedAt) : formatDate(localData!.pubDate)}</time>
        {post?.updatedAt && (
          <span class="text-xs text-muted-foreground/70">
            更新于 {formatDateFull(post.updatedAt)}
          </span>
        )}
      </div>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-x-4 gap-y-1 mt-4 text-sm text-muted-foreground">
          {tags.map((tag) => (
            <span class="hover:text-accent transition-colors">
              <span class="text-accent">#</span> {tag}
            </span>
          ))}
        </div>
      )}
    </header>

    {post?.coverImage && (
      <img
        src={post.coverImage}
        alt={post.title}
        class="w-full mb-10 border border-border"
        loading="lazy"
      />
    )}

    {post ? (
      <div class="prose max-w-none" set:html={post.html} />
    ) : LocalContent && (
      <div class="prose max-w-none">
        <LocalContent />
      </div>
    )}

    {comments && comments.enabled && post?.commentsEnabled !== false && (
      <section class="comments" id="comments">
        <h2 class="comments-title">评论</h2>
        {comments.provider === 'giscus' && comments.giscusRepo && (
          <script
            is:inline
            src="https://giscus.app/client.js"
            data-repo={comments.giscusRepo}
            data-repo-id={comments.giscusRepoId}
            data-category={comments.giscusCategory}
            data-category-id={comments.giscusCategoryId}
            data-mapping="pathname"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="bottom"
            data-theme="preferred_color_scheme"
            data-lang="zh-CN"
            data-loading="lazy"
            crossorigin="anonymous"
            async
          />
        )}
        {comments.provider === 'utterances' && (comments.utterancesRepo || comments.giscusRepo) && (
          <script
            is:inline
            src="https://utteranc.es/client.js"
            data-repo={comments.utterancesRepo || comments.giscusRepo}
            data-issue-term="pathname"
            data-theme="preferred_color_scheme"
            data-label="comments"
            crossorigin="anonymous"
            async
          />
        )}
        {comments.provider === 'waline' && configuredWaline && (
          <div id="waline" data-waline-path={`/posts/${slug}`}></div>
        )}
        {!['giscus', 'utterances', 'waline'].includes(comments.provider) && (
          <p class="comments-note">评论系统尚未配置（请在后台「评论系统」中配置）。</p>
        )}
        {comments.provider === 'waline' && !configuredWaline && (
          <p class="comments-note">评论系统尚未配置 Waline 服务地址（请在后台「评论系统」中设置）。</p>
        )}
      </section>
    )}

    <div class="mt-16 pt-8">
      <a href="/" class="inline-flex items-center gap-2 text-sm font-serif text-muted-foreground hover:text-accent transition-colors">
        <span>&larr;</span> 返回文章列表
      </a>
    </div>
  </article>
</Layout>

<script define:vars={{ walineServerURL: configuredWaline }}>
  import { init } from '@waline/client';
  import '@waline/client/style';

  function initComments() {
    const el = document.getElementById('waline');
    if (el && walineServerURL) {
      init({
        el: '#waline',
        serverURL: walineServerURL,
        path: el.dataset.walinePath || window.location.pathname,
        lang: 'zh-CN',
        dark: 'html[data-theme="dark"]',
        pageview: true,
        comment: true,
      });
    }
  }
  initComments();
  document.addEventListener('astro:page-load', initComments);
</script>
