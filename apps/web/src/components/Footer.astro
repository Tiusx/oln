---
import type { SiteConfig } from '@/lib/api';

interface Props {
  config: SiteConfig | null;
}

const { config } = Astro.props;
const year = new Date().getFullYear();
const siteName = config?.basic.siteName || 'Blog';
const footerText = config?.footer.footerText;
const beian = config?.footer.beian;
const adminUrl = import.meta.env.PUBLIC_ADMIN_URL || '/admin/';
---

<footer class="border-t border-border mt-20">
  <div class="mx-auto max-w-4xl px-6 py-10 flex flex-col md:flex-row items-center justify-between gap-3 text-sm text-muted-foreground">
    <span class="font-serif">{footerText || `© ${year} ${siteName}`}</span>
    <div class="flex items-center gap-6 text-sm font-serif">
      {beian && (
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener" class="hover:text-foreground transition-colors">
          {beian}
        </a>
      )}
      <a href={adminUrl} rel="noopener" class="hover:text-foreground transition-colors" aria-label="后台管理">
        后台管理
      </a>
    </div>
  </div>
</footer>
