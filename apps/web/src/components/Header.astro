---
import type { SiteConfig } from '@/lib/api';
import ThemeToggle from '@/components/ThemeToggle';

interface Props {
  config: SiteConfig | null;
  themePreferred?: 'system' | 'light' | 'dark';
  allowToggle?: boolean;
}

const { config, themePreferred = 'system', allowToggle = true } = Astro.props;
const currentPath = Astro.url.pathname;

const siteName = config?.basic.siteName || 'Blog';
const logo = config?.basic.logo;
const menu = config?.nav.menu || [];
const builtinLinks = Array.isArray(config?.nav?.builtin?.links) ? config.nav.builtin.links : [];
const showBuiltin = config?.nav?.builtin?.show !== false;
const extraMenu = showBuiltin ? builtinLinks.filter((l) => l.enabled) : [];

interface NavItem {
  url: string;
  label: string;
  target?: string;
  rel?: string;
}

const navLinks: NavItem[] = [
  { url: '/', label: '首页' },
  ...menu.map((item): NavItem => ({ url: item.url, label: item.label, target: item.newWindow ? '_blank' : undefined, rel: item.newWindow ? 'noopener' : undefined })),
  ...extraMenu.map((item): NavItem => ({ url: item.url, label: item.label })),
];

function isActive(url: string): boolean {
  if (url === '/') return currentPath === '/' || currentPath === '';
  return currentPath === url || currentPath.startsWith(url + '/');
}
---

<header class="fixed top-0 left-0 right-0 z-50 bg-background/85 backdrop-blur-md border-b border-border">
  <nav class="mx-auto max-w-4xl flex items-center justify-between h-16 px-6 gap-4">
    <a href="/" class="flex items-center shrink-0 gap-2 text-lg font-bold font-serif tracking-tight text-foreground">
      {logo ? (
        <img src={logo} alt={siteName} class="h-7 w-7 object-cover rounded-full" />
      ) : null}
      <span>{siteName}</span>
    </a>
    <div class="flex items-center gap-5 md:gap-7 text-[15px] font-serif overflow-x-auto md:overflow-visible whitespace-nowrap">
      {navLinks.map((link) => (
        <a
          href={link.url}
          target={link.target}
          rel={link.rel}
          aria-current={isActive(link.url) ? 'true' : undefined}
          class={`relative py-1 transition-colors ${
            isActive(link.url)
              ? 'text-foreground font-medium underline underline-offset-[6px] decoration-accent decoration-2'
              : 'text-muted-foreground hover:text-accent'
          }`}
        >
          {link.label}
        </a>
      ))}
      {allowToggle && <ThemeToggle client:idle preferred={themePreferred} />}
    </div>
  </nav>
</header>
<div class="h-16"></div>
