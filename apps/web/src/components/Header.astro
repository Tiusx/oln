---
import type { SiteConfig } from '../lib/api';

interface Props {
  config: SiteConfig;
  currentPath?: string;
}

const { config, currentPath = '' } = Astro.props;
const siteName = config.basic.siteName || 'Blog';
const menu = config.nav.menu || [];
const allowToggle = config.theme?.allowToggle !== false;
const skin = config.theme?.active || 'default';
const preferred = config.theme?.preferred || 'system';

// 内置默认导航（友链/关于/留言板/一言），可在后台"站点设置-导航"中开关
const builtin = Array.isArray(config.nav?.builtin?.links)
  ? config.nav.builtin.links
  : [];
const showBuiltin = config.nav?.builtin?.show !== false;
const extraMenu = showBuiltin ? builtin.filter((l) => l.enabled) : [];
const isCurrent = (url: string) => {
  if (url === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(url);
};

// Build the full nav link list (menu + builtin links)
const navLinks = [
  { url: '/', label: '首页' },
  ...menu.map((item) => ({ url: item.url, label: item.label, target: item.newWindow ? '_blank' : undefined, rel: item.newWindow ? 'noopener' : undefined })),
  ...extraMenu.map((item) => ({ url: item.url, label: item.label, target: item.newWindow ? '_blank' : undefined, rel: item.newWindow ? 'noopener' : undefined })),
];
---

<header class="site-header">
  <div class="inner">
    {config.basic.logo ? (
      <a class="site-title" href="/">
        <img class="site-logo" src={config.basic.logo} alt={siteName} />
      </a>
    ) : (
      <a class="site-title" href="/">{siteName}</a>
    )}
    <nav class="site-nav site-nav-desktop">
      {navLinks.map((item) => (
        <a
          href={item.url}
          target={item.target}
          rel={item.rel}
          aria-current={isCurrent(item.url) ? 'true' : undefined}
        >
          {item.label}
        </a>
      ))}
      {allowToggle && (
        <button class="theme-toggle" type="button" id="themeToggleDesk" aria-label="切换主题" title="切换明暗主题">
          <svg class="ico-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5"/>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
          </svg>
          <svg class="ico-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/>
          </svg>
        </button>
      )}
      <a class="rss-link" href="/rss.xml" title="RSS 订阅" aria-label="RSS 订阅">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <circle cx="6.18" cy="17.82" r="2.18"/>
          <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83C19.56 11.44 12.56 4.44 4 4.44z"/>
          <path d="M4 10.1v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83C13.9 14.8 9.2 10.1 4 10.1z"/>
        </svg>
      </a>
    </nav>
    <button class="nav-toggle" type="button" id="navToggle" aria-label="菜单" aria-controls="siteNav" aria-expanded="false">
      <svg class="ico-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" aria-hidden="true">
        <path class="bar-1" d="M4 6h16"/>
        <path class="bar-2" d="M4 12h16"/>
        <path class="bar-3" d="M4 18h16"/>
      </svg>
      <svg class="ico-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>
</header>

{/* Drawer + backdrop are rendered as direct children of <body> (outside the
    header) so .site-header's `backdrop-filter` does not create a containing
    block that breaks the fixed positioning / z-index of the panel. */}
<div class="drawer-backdrop" id="drawerBackdrop" hidden></div>
<aside class="drawer" id="drawer" role="dialog" aria-modal="true" aria-label="导航菜单">
  <div class="drawer-head">
    <span class="drawer-brand">{siteName}</span>
    <button class="drawer-close" type="button" id="drawerClose" aria-label="关闭菜单">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>
  <nav class="site-nav" id="siteNav">
    {navLinks.map((item) => (
      <a
        href={item.url}
        target={item.target}
        rel={item.rel}
        aria-current={isCurrent(item.url) ? 'true' : undefined}
      >
        {item.label}
      </a>
    ))}
    {allowToggle && (
      <button class="theme-toggle" type="button" id="themeToggle" aria-label="切换主题" title="切换明暗主题">
        <svg class="ico-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"/>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
        <svg class="ico-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/>
        </svg>
      </button>
    )}
    <a class="rss-link" href="/rss.xml" title="RSS 订阅" aria-label="RSS 订阅">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <circle cx="6.18" cy="17.82" r="2.18"/>
        <path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83C19.56 11.44 12.56 4.44 4 4.44z"/>
        <path d="M4 10.1v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83C13.9 14.8 9.2 10.1 4 10.1z"/>
      </svg>
    </a>
  </nav>
</aside>

<script is:inline define:vars={{ skin, preferred }}>
  // Event delegation bound once on the persistent `document` object. The
  // ClientRouter keeps the same `document` across View Transitions, so this
  // single delegated listener keeps working on the freshly-swapped-in header,
  // drawer and backdrop after every client-side navigation — no re-binding,
  // no lost listeners, no accumulation. The `__headerBound` flag prevents
  // re-binding when Astro re-executes this inline script on each navigation.
  (function () {
    if (window.__headerBound) return;
    window.__headerBound = true;

    const KEY = 'blog-theme';
    function pickMode() {
      if (preferred === 'light') return 'light';
      if (preferred === 'dark') return 'dark';
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    function current() {
      return localStorage.getItem(KEY) || pickMode();
    }
    function apply(t) {
      document.documentElement.dataset.theme = t;
      document.documentElement.dataset.skin = skin;
    }
    apply(current());

    function openDrawer(navToggle) {
      const drawer = document.getElementById('drawer');
      const backdrop = document.getElementById('drawerBackdrop');
      if (!drawer || !backdrop) return;
      backdrop.hidden = false;
      void backdrop.offsetWidth; // force reflow so the transition animates
      drawer.classList.add('is-open');
      backdrop.classList.add('is-open');
      navToggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer(navToggle) {
      const drawer = document.getElementById('drawer');
      const backdrop = document.getElementById('drawerBackdrop');
      if (!drawer || !backdrop) return;
      drawer.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      navToggle && navToggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      setTimeout(() => {
        backdrop.hidden = true;
      }, 280);
    }
    function isOpen() {
      var b = document.getElementById('drawerBackdrop');
      return b && b.classList.contains('is-open');
    }

    document.addEventListener('click', (e) => {
      const navToggle = e.target.closest
        ? e.target.closest('#navToggle')
        : null;
      // Light / dark theme toggle (desktop + drawer)
      if ((e.target.closest && e.target.closest('#themeToggle')) ||
          (e.target.closest && e.target.closest('#themeToggleDesk'))) {
        const next = current() === 'dark' ? 'light' : 'dark';
        localStorage.setItem(KEY, next);
        apply(next);
        return;
      }
      // Hamburger: toggle the drawer open/closed
      if (navToggle) {
        if (isOpen()) {
          closeDrawer(navToggle);
        } else {
          openDrawer(navToggle);
        }
        return;
      }
      // Close button inside the drawer
      if (e.target.closest && e.target.closest('#drawerClose')) {
        const t = document.getElementById('navToggle');
        closeDrawer(t);
        return;
      }
      // Click on the dimmed backdrop
      if (e.target.closest && e.target.closest('#drawerBackdrop')) {
        const t = document.getElementById('navToggle');
        closeDrawer(t);
        return;
      }
      // Click on any nav link inside the drawer -> close it
      const link = e.target.closest && e.target.closest('#drawer a');
      if (link) {
        const t = document.getElementById('navToggle');
        closeDrawer(t);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const t = document.getElementById('navToggle');
        closeDrawer(t);
      }
    });
  })();
</script>
