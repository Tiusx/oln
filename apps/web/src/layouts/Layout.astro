---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BackToTop from '@/components/BackToTop';
import { ClientRouter } from 'astro:transitions';
import { api, type SiteConfig } from '@/lib/api';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  config?: SiteConfig | null;
  type?: 'website' | 'article';
  image?: string;
  canonical?: string;
}

const { title, description, config = null, type = 'website', image, canonical } = Astro.props;

const configData = config ?? (await api.config().catch(() => null));

const siteName = configData?.basic.siteName || 'Blog';
const language = configData?.basic.language || 'zh-CN';
const fullTitle = title ? `${title} - ${siteName}` : siteName;
const siteDescription = description || configData?.seo.description || siteName;
const favicon = configData?.basic.favicon;
const ogImage = image || configData?.seo.ogImage || configData?.basic.logo || undefined;
const pageUrl = canonical || (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href);
const themeSkin = configData?.theme.active || 'default';
const themePreferred = configData?.theme.preferred || 'system';
const allowToggle = configData?.theme.allowToggle !== false;
---

<!doctype html>
<html lang={language} data-skin={themeSkin}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content="Astro" />
    <ClientRouter />

    <script is:inline define:vars={{ preferred: themePreferred }}>
      (function () {
        try {
          var t = localStorage.getItem('blog-theme');
          if (!t) {
            if (preferred === 'dark') t = 'dark';
            else if (preferred === 'light') t = 'light';
            else t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          var root = document.documentElement;
          root.classList.toggle('dark', t === 'dark');
          root.classList.toggle('light', t === 'light');
          root.dataset.theme = t;
        } catch (e) {}
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={siteDescription} />
    {configData?.seo.keywords && <meta name="keywords" content={configData.seo.keywords} />}
    {configData?.seo.enableRobots !== false && <meta name="robots" content="index, follow" />}
    {favicon && <link rel="icon" href={favicon} />}
    <link rel="canonical" href={pageUrl} />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={language} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={siteDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    {configData?.inject.headHtml && <Fragment set:html={configData.inject.headHtml} />}
    {configData?.features.analytics.enabled &&
      configData.features.analytics.webAnalyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${configData.features.analytics.webAnalyticsToken}"}`}
      />
    )}
  </head>
  <body>
    <Header config={configData} themePreferred={themePreferred} allowToggle={allowToggle} />
    <main class="min-h-[calc(100vh-8rem)]">
      <slot />
    </main>
    <Footer config={configData} />
    <BackToTop client:visible />
    {configData?.inject.footHtml && <Fragment set:html={configData.inject.footHtml} />}
    <script>
      // Code block enhancer: add a language label + copy button to every
      // `<pre>` inside `.prose` markdown output. Runs on each page load and
      // on View-Transition navigations (guarded to stay idempotent).
      const COPY_ICON =
        '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
      const CHECK_ICON =
        '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';

      function copyText(text, btn, label) {
const done = () => {
          btn.classList.add('copied');
          btn.setAttribute('aria-label', 'Copied');
          btn.innerHTML = `${CHECK_ICON}<span class="code-block__copy-label">Copied</span>`;
          setTimeout(() => {
            btn.classList.remove('copied');
            btn.setAttribute('aria-label', 'Copy code');
            btn.innerHTML = `${COPY_ICON}<span class="code-block__copy-label">Copy</span>`;
          }, 2000);
        };
        const fallback = () => {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch {}
          document.body.removeChild(ta);
          done();
        };
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(done).catch(fallback);
        } else {
          fallback();
        }
      }

      function enhanceCodeBlocks() {
        const blocks = document.querySelectorAll('.prose pre');
        for (const pre of blocks) {
          if (pre.dataset.codeBlock === '1') continue;
          const code = pre.querySelector('code');
          if (!code) continue;
          pre.dataset.codeBlock = '1';

          const wrap = document.createElement('div');
          wrap.className = 'code-block';

          const bar = document.createElement('div');
          bar.className = 'code-block__bar';

          const m = (code.className || '').match(/language-([\w+-]+)/);
          const langName = m ? m[1] : (pre.dataset.language || code.dataset.language || '');
          if (langName) {
            const lang = document.createElement('span');
            lang.className = 'code-block__lang';
            lang.textContent = langName;
            bar.appendChild(lang);
          } else {
            bar.appendChild(document.createElement('span'));
          }

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'code-block__copy';
          btn.setAttribute('aria-label', 'Copy code');
          btn.innerHTML = `${COPY_ICON}<span class="code-block__copy-label">Copy</span>`;
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            copyText(code.innerText, btn, 'Copy');
          });
          bar.appendChild(btn);

          pre.parentNode.insertBefore(wrap, pre);
          wrap.appendChild(bar);
          wrap.appendChild(pre);
        }
      }

      enhanceCodeBlocks();
      document.addEventListener('astro:page-load', enhanceCodeBlocks);
    </script>
  </body>
</html>
